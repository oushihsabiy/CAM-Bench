# Ignore everything by default. Add allow-list rules below for source code,
# project config, and documentation.
*
!*/
!.gitignore

# Source code
!*.py
!*.pyi
!*.lean
!*.c
!*.h
!*.js
!*.jsx
!*.ts
!*.tsx
!*.css
!*.html
!*.sh

# Project config and dependency metadata
!*.toml
!*.yaml
!*.yml
!requirements*.txt
!setup.cfg
!pyrightconfig.json
!tsconfig.json
!package.json
!package-lock.json
!config*.json
!settings.json
!lake-manifest.json
!lean-toolchain

# Documentation and licenses
!*.md
!*.rst
!LICENSE
!LICENSE.*

# Local tools, environments, caches, and editor files
.codex
.agents/
.venv/
venv/
env/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
**/.cache/
**/.codex_home/
**/uv_cache/
.DS_Store
.idea/
.vscode/

# Logs and run traces
*.log
*.log.*
**/*.log
**/*.log.*
log/
logs/
**/log/
**/logs/
**/proof_log/
**/*trace*

# Data, benchmarks, generated outputs, and evaluation results
/benchmark/
/result/
/selected/
**/data/
**/data-*/
**/data_*/
**/dataset/
**/datasets/
**/input_pdfs/
**/output/
**/output_*/
**/outputs/
**/result/
**/results/
**/raw_results/
**/review_log/
**/output_review/
**/preprocessed_data/
**/cache/
**/.cache_*/
**/work/
**/tmp/
**/temp/
**/error_problem/
**/selected/
**/retry-*/
**/revise-*/

# Embedded evaluation repositories and generated Lean projects
/evaluation/LeanBenchmark-Difficulty-Assessments/
/evaluation/LeanBenchmark-Difficulty-Assessments-2/
/evaluation/LeanBenchmark-Difficulty-Assessments-ds-pfbody/
/evaluation/LeanBenchmark-Difficulty-Assessments-gemini/
/evaluation/LeanBenchmark-Difficulty-Assessments-gpt/
/evaluation/lean/Leanproject/
/evaluation/aristotle/result_extracted/
/proofbench-evaluation-hard/proof-bench/
/proofbench-evaluation-pass32/proof-bench/

# Lean build artifacts and vendored Lake packages
**/.lake/
**/.elan/
**/lake-packages/
**/.lake/packages/
*.olean
*.ilean
*.o
*.so
*.trace
*.hash

# Large or non-source data files
*.json
*.jsonl
*.csv
*.tsv
*.xlsx
*.sqlite
*.sqlite-*
*.db
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.bin
*.gz
*.zip
*.tar
*.tgz
*.7z
*.msgpack

# Re-allow selected JSON config files after data JSON is ignored.
!config*.json
!settings.json
!pyrightconfig.json
!tsconfig.json
!package.json
!package-lock.json
!lake-manifest.json
