{
  "preprocessing": {
    "enabled": true,
    "max_attempts": 8,
    "exclude_hints": true,
    "normalize_skip_thm": true
  },
  "translation": {
    "mcp_enabled": true,
    "mcp_pool_size": 1,
    "mcp_repo_path": null,
    "mcp_tool_mode": "targeted",
    "mcp_tools": ["lean_unified_search","lean_leansearch"]
  },
  "semantic": {
    "enabled": true,
    "max_rounds": 8
  },
  "recovery": {
    "max_retries": 8,
    "api_first_rounds": 2,
    "api_first_mcp_enabled": true,
    "mcp_enabled": false,
    "mcp_pool_size": 1,
    "mcp_repo_path": null,
    "mcp_tool_mode": "all",
    "mcp_tools": ["lean_unified_search","lean_leansearch","lean_hover"],
    "use_common_errors": true
  },
  "lean": {
    "toolchain_dir": "lean",
    "timeout_seconds": 120
  },
  "compile": {
    "use_lake_env": true,
    "auto_cache_recovery": true
  },
  "timeout_seconds": 180.0
}
