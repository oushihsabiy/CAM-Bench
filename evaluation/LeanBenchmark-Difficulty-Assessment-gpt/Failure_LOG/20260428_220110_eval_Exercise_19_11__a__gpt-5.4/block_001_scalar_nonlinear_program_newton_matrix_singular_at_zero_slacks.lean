theorem scalar_nonlinear_program_newton_matrix_singular_at_zero_slacks
    (x z1 z2 : ℝ) :
    singular
      (fun i j : Fin 5 =>
        match (i.1, j.1) with
        | (0, 0) => -2 * z1
        | (0, 1) => 0
        | (0, 2) => 0
        | (0, 3) => -2 * x
        | (0, 4) => -1
        | (1, 0) => 0
        | (1, 1) => z1
        | (1, 2) => 0
        | (1, 3) => 0
        | (1, 4) => 0
        | (2, 0) => 0
        | (2, 1) => 0
        | (2, 2) => z2
        | (2, 3) => 0
        | (2, 4) => 0
        | (3, 0) => 2 * x
        | (3, 1) => -1
        | (3, 2) => 0
        | (3, 3) => 0
        | (3, 4) => 0
        | (4, 0) => 1
        | (4, 1) => 0
        | (4, 2) => -1
        | (4, 3) => 0
        | (4, 4) => 0
        | _ => 0) := by
  sorry
